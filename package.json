{
  "name": "campus-auction-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "build:api": "npm --workspace=@campus/shared run build && npm --workspace=@campus/api run build",
    "start": "node apps/api/dist/index.js",
    "start:api": "node apps/api/dist/index.js",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "dependencies": {
    "typescript": "^5.4.5"
  }
}
